# LLM backend setup for non-interactive analysis:
# set TRADINGAGENTS_LLM_PROVIDER plus the matching provider API key below,
# or set TRADINGAGENTS_LLM_PROVIDER=ollama and run Ollama locally/remotely.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# Required for unattended runs: choose a configured API-key provider or ollama.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
# Use this for OpenAI-compatible custom endpoints or Ollama, e.g.
# http://localhost:11434/v1. Leave blank for provider defaults.
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
# Analysis symbol is used for market data and reports, while broker symbol is
# used for execution when your broker names the same instrument differently.
#TRADINGAGENTS_ANALYSIS_SYMBOL=GC=F
#TRADINGAGENTS_BROKER_SYMBOL=XAUUSD.vx
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
#TRADINGAGENTS_MARKET_TIMEZONE=America/New_York
#TRADINGAGENTS_FAST_MIN_CANDIDATE_SCORE=8
#TRADINGAGENTS_FAST_MIN_STOP_SPREAD_MULTIPLE=2
#TRADINGAGENTS_RUNNER_MAX_CYCLES=0
#TRADINGAGENTS_RUNNER_LOSS_STREAK_COOLDOWN_COUNT=2
#TRADINGAGENTS_RUNNER_LOSS_STREAK_COOLDOWN_SECONDS=600

# MT5 account connection. Keep the populated values only in the local .env.
# The deterministic One Minute Scalper requires a DEMO account.
#TRADINGAGENTS_MT5_LOGIN=
#TRADINGAGENTS_MT5_PASSWORD=
#TRADINGAGENTS_MT5_SERVER=
#TRADINGAGENTS_MT5_SYMBOL=XAUUSD
#TRADINGAGENTS_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Required account guards. Leave the real-order acknowledgement absent.
#TRADINGAGENTS_REQUIRE_DEMO_ACCOUNT=true
#TRADINGAGENTS_MT5_ALLOW_REAL_ORDERS=false
#TRADINGAGENTS_MT5_EXPECTED_LOGIN=
#TRADINGAGENTS_MT5_EXPECTED_SERVER=

# Order sizing and metadata.
#TRADINGAGENTS_MT5_VOLUME=1.0
#TRADINGAGENTS_MT5_DEVIATION=20
#TRADINGAGENTS_MT5_MAGIC=150015
#TRADINGAGENTS_MT5_ORDER_COMMENT=TradingAgents
# Stable active-trade state survives fresh telemetry/result directories.
#TRADINGAGENTS_MT5_EXECUTION_STATE_DIR=runtime/mt5_execution_state

# Safe deterministic One Minute Scalper runner profile.
#TRADINGAGENTS_TRADING_MODE=ENTRY_ONLY
#TRADINGAGENTS_DECISION_MODE=engine
#TRADINGAGENTS_ENTRY_PROFILE_MODE=fast_only
#TRADINGAGENTS_FAST_ENTRIES_ENABLED=true
#TRADINGAGENTS_TIMEFRAME=1m
#TRADINGAGENTS_CONFIRMATION_TIMEFRAME=1m
#TRADINGAGENTS_FAST_TIMEFRAME=1m
#TRADINGAGENTS_FAST_CONFIRMATION_TIMEFRAME=1m
#TRADINGAGENTS_FAST_HISTORY_WINDOW_CANDLES=60
#TRADINGAGENTS_FAST_REACTION_PENDING_SECONDS=20
#TRADINGAGENTS_FAST_IMPULSE_PENDING_SECONDS=45
#TRADINGAGENTS_FAST_VOLUME_BOOST_ENABLED=false
#TRADINGAGENTS_RUNNER_POLL_SECONDS=5
#TRADINGAGENTS_RUNNER_MAINTENANCE_POLL_SECONDS=1
#TRADINGAGENTS_RUNNER_MAX_SESSION_LOSS=600
#TRADINGAGENTS_RESULTS_DIR=
